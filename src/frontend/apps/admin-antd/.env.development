# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址（须与正在运行的 Ncp.Admin.Web 端口一致，launchSettings 默认 5511）
VITE_GLOB_API_URL=http://localhost:5511/api/admin

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
